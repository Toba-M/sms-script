
#!/usr/bin/env bash
# Huawei SMS offline Dracut recovery v2 — BIOS and UEFI (conventional GRUB).
# Run ONLY on a healthy Huawei recovery ECS, with the failed system disk attached
# as a DATA disk. Never run on the Azure source or on a functioning target.
# This is a tested-manually-derived recovery workflow, NOT a universal boot fix.
set -Eeuo pipefail

usage() {
  cat <<'HELP'
Huawei SMS offline initramfs recovery v2 (BIOS + conventional UEFI/GRUB)

  sudo bash huawei_sms_offline_initramfs_recovery.sh --disk /dev/vdb
  sudo bash huawei_sms_offline_initramfs_recovery.sh --disk /dev/vdb --firmware uefi
  sudo bash huawei_sms_offline_initramfs_recovery.sh --disk /dev/vdb --firmware uefi --apply

Optional: --root-part DEVICE --boot-part DEVICE --efi-part DEVICE
          --kernel VERSION --firmware auto|bios|uefi --apply

Default: read-only inspection (no migrated-disk writes).
--apply: rebuild the detached OS initramfs with a backup and confirmation.

Supported: unencrypted GPT/MBR, ext4 root, ext4 /boot (separate or within root),
conventional GRUB + Dracut; optional FAT32 EFI System Partition for UEFI.
Unsupported layouts fail closed: LUKS, LVM root, XFS/Btrfs, UKI-only boots,
missing or uncertain boot references, multiple kernels without --kernel.

Before --apply: finish SMS and any incremental sync, stop the failed target,
snapshot the affected EVS disk, and attach it as a DATA disk to the recovery ECS.
This tool never formats a disk, reinstalls GRUB, or modifies the Azure source.
HELP
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

log() {
  printf '\n==> %s\n' "$*"
}

need() {
  command -v "$1" >/dev/null 2>&1 ||
    fail "Missing command: $1"
}

DISK=''
ROOT=''
BOOT=''
ESP=''
KERNEL=''
FW=auto
APPLY=0

while (($#)); do
  case "$1" in
    --disk|--root-part|--boot-part|--efi-part|--kernel|--firmware)
      (($# >= 2)) || fail "Missing value for $1"
      case "$1" in
        --disk) DISK=$2 ;;
        --root-part) ROOT=$2 ;;
        --boot-part) BOOT=$2 ;;
        --efi-part) ESP=$2 ;;
        --kernel) KERNEL=$2 ;;
        --firmware) FW=$2 ;;
      esac
      shift 2
      ;;
    --apply)
      APPLY=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

[[ $EUID == 0 ]] || fail 'Run with sudo/root.'
[[ -n $DISK ]] || {
  usage
  fail 'Specify --disk explicitly.'
}

[[ $FW == auto || $FW == bios || $FW == uefi ]] ||
  fail 'Invalid --firmware value.'

for c in lsblk blkid findmnt mount umount readlink mktemp awk grep chroot \
         cp mv sync lsinitrd stat df head date file find; do
  need "$c"
done

resolve() {
  [[ -b $1 ]] || fail "Not a block device: $1"
  readlink -f -- "$1"
}

DISK=$(resolve "$DISK")

[[ $(lsblk -dnro TYPE "$DISK") == disk ]] ||
  fail 'Select a whole disk, not a partition.'

[[ -z $ROOT ]] || ROOT=$(resolve "$ROOT")
[[ -z $BOOT ]] || BOOT=$(resolve "$BOOT")
[[ -z $ESP ]] || ESP=$(resolve "$ESP")

# Protect the recovery ECS's active root disk.
LIVE_MM=$(findmnt -nro MAJ:MIN /)

while IFS= read -r mm; do
  [[ "$mm" != "$LIVE_MM" ]] ||
    fail 'Selected disk contains the recovery ECS live root!'
done < <(lsblk -nr -o MAJ:MIN "$DISK")

# Refuse disks that already contain mounted filesystems.
if [[ -n $(lsblk -nr -o MOUNTPOINTS "$DISK" | grep -v '^$' || :) ]]; then
  lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINTS "$DISK"
  fail 'The selected disk already has mounted filesystems.'
fi

is_child() {
  local p=$1 parent
  [[ $(lsblk -dnro TYPE "$p") == part ]] || return 1
  parent=$(lsblk -dnro PKNAME "$p")
  [[ -n $parent ]] &&
    [[ $(readlink -f "/dev/$parent") == "$DISK" ]]
}

for p in "$ROOT" "$BOOT" "$ESP"; do
  [[ -z $p ]] || is_child "$p" ||
    fail "$p is not a direct partition of $DISK"
done

FS_MNT=$(mktemp -d /mnt/sms-recovery-v2.XXXXXXXX)
ROOT_MOUNTED=0

cleanup() {
  local rc=$?
  trap - EXIT INT TERM

  if ((ROOT_MOUNTED)); then
    sync || :

    if ! umount -R "$FS_MNT"; then
      printf 'UNMOUNT FAILED! DO NOT DETACH THE DISK. Check: findmnt -R %s\n' \
        "$FS_MNT" >&2
      lsblk -o NAME,SIZE,MOUNTPOINTS "$DISK" >&2 || :
      exit 1
    fi
  fi

  rmdir "$FS_MNT" 2>/dev/null || :
  exit "$rc"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mount_ext4() {
  local dev=$1 loc=$2 mode=$3

  [[ $(blkid -s TYPE -o value "$dev") == ext4 ]] ||
    fail "$dev is not ext4"

  if [[ $mode == ro ]]; then
    mount -t ext4 -o ro,noload "$dev" "$loc"
  else
    mount -t ext4 -o rw "$dev" "$loc"
  fi
}

# Identify the migrated root partition using read-only inspection.
if [[ -z $ROOT ]]; then
  log 'Looking for migrated root filesystem (read-only)'
  choices=()

  while IFS= read -r p; do
    [[ $(blkid -s TYPE -o value "$p" 2>/dev/null || :) == ext4 ]] ||
      continue

    if mount -t ext4 -o ro,noload "$p" "$FS_MNT" 2>/dev/null; then
      if [[ -f "$FS_MNT/etc/fstab" &&
            -f "$FS_MNT/etc/os-release" ]]; then
        choices+=("$p")
      fi
      umount "$FS_MNT" ||
        fail 'Could not unmount a scan candidate.'
    fi
  done < <(
    lsblk -nrlpo NAME,TYPE "$DISK" |
      awk '$2=="part" {print $1}'
  )

  ((${#choices[@]} == 1)) ||
    fail "Found ${#choices[@]} root candidates; pass --root-part explicitly."

  ROOT=${choices[0]}
fi

[[ -z $BOOT || $ROOT != "$BOOT" ]] ||
  fail 'Do not pass root as --boot-part; omit --boot-part for integrated /boot.'

[[ -z $ESP || ($ESP != "$ROOT" && $ESP != "$BOOT") ]] ||
  fail 'EFI partition overlaps other partitions.'

mount_ext4 "$ROOT" "$FS_MNT" ro
ROOT_MOUNTED=1

[[ -f "$FS_MNT/etc/fstab" &&
   -f "$FS_MNT/etc/os-release" ]] ||
  fail 'Selected root is not a recognized Linux installation.'

fstab_spec() {
  awk -v target="$1" \
    '$1 !~ /^#/ && $2==target {print $1; exit}' \
    "$FS_MNT/etc/fstab"
}

part_matches() {
  local spec=$1 p=$2 key expect

  case $spec in
    UUID=*)
      key=UUID
      expect=${spec#UUID=}
      ;;
    PARTUUID=*)
      key=PARTUUID
      expect=${spec#PARTUUID=}
      ;;
    LABEL=*)
      key=LABEL
      expect=${spec#LABEL=}
      ;;
    PARTLABEL=*)
      key=PARTLABEL
      expect=${spec#PARTLABEL=}
      ;;
    *)
      return 1
      ;;
  esac

  [[ $(blkid -s "$key" -o value "$p" 2>/dev/null || :) == "$expect" ]]
}

find_partition_for_spec() {
  local spec=$1 type=${2:-ext4} p
  local found=()

  while IFS= read -r p; do
    [[ $(blkid -s TYPE -o value "$p" 2>/dev/null || :) == "$type" ]] ||
      continue
    part_matches "$spec" "$p" && found+=("$p")
  done < <(
    lsblk -nrlpo NAME,TYPE "$DISK" |
      awk '$2=="part" {print $1}'
  )

  ((${#found[@]} == 1)) ||
    fail "Cannot uniquely resolve fstab '$spec' ($type) on $DISK."

  printf '%s\n' "${found[0]}"
}

ROOT_SPEC=$(fstab_spec /)

[[ -n $ROOT_SPEC ]] ||
  fail 'No / entry in migrated fstab.'

part_matches "$ROOT_SPEC" "$ROOT" ||
  fail 'fstab root does not match selected root partition.'

BOOT_SPEC=$(fstab_spec /boot)

if [[ -n $BOOT_SPEC ]]; then
  [[ -n $BOOT ]] ||
    BOOT=$(find_partition_for_spec "$BOOT_SPEC" ext4)

  is_child "$BOOT" ||
    fail 'Boot is not a partition of selected disk.'

  part_matches "$BOOT_SPEC" "$BOOT" ||
    fail 'fstab /boot does not match selected boot partition.'

  [[ -d $FS_MNT/boot ]] ||
    fail 'Missing /boot mount directory.'

  mount_ext4 "$BOOT" "$FS_MNT/boot" ro
else
  [[ -z $BOOT ]] ||
    fail 'No separate /boot in fstab. Omit --boot-part.'

  [[ -d $FS_MNT/boot ]] ||
    fail 'Missing integrated /boot.'
fi

# Detect common BIOS and UEFI GPT partition types.
# Do not assume that an ESP alone proves UEFI boot.
ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
BIOS_GUID=21686148-6449-6e6f-744e-656564454649

HAS_ESP=0
HAS_BIOS=0

while IFS= read -r p; do
  guid=$(blkid -s PART_ENTRY_TYPE -o value "$p" 2>/dev/null || :)
  guid=${guid,,}

  [[ $guid == "$ESP_GUID" ]] && HAS_ESP=1
  [[ $guid == "$BIOS_GUID" ]] && HAS_BIOS=1
done < <(
  lsblk -nrlpo NAME,TYPE "$DISK" |
    awk '$2=="part" {print $1}'
)

if [[ $FW == auto ]]; then
  if (( HAS_ESP && HAS_BIOS )); then
    fail 'Both ESP and BIOS boot partitions exist. Specify --firmware bios or --firmware uefi after checking the original target firmware.'
  elif (( HAS_ESP )); then
    FW=uefi
  elif (( HAS_BIOS )); then
    FW=bios
  else
    fail 'Cannot infer firmware safely. Specify --firmware bios or --firmware uefi.'
  fi
fi

ESP_MOUNT=''

# Validate the conventional UEFI layout.
if [[ $FW == uefi ]]; then
  [[ -n $ESP ]] || {
    ESP_MOUNT=/boot/efi
    EFI_SPEC=$(fstab_spec /boot/efi)

    if [[ -z $EFI_SPEC ]]; then
      ESP_MOUNT=/efi
      EFI_SPEC=$(fstab_spec /efi)
    fi

    [[ -n $EFI_SPEC ]] ||
      fail 'UEFI selected, but no /boot/efi or /efi fstab entry. Unsupported layout.'

    ESP=$(find_partition_for_spec "$EFI_SPEC" vfat)
  }

  is_child "$ESP" ||
    fail 'EFI partition does not belong to selected disk.'

  [[ $(blkid -s TYPE -o value "$ESP") == vfat ]] ||
    fail 'EFI partition must be FAT32/vfat.'

  if [[ -z $ESP_MOUNT ]]; then
    ESP_MOUNT=/boot/efi
    [[ -z $(fstab_spec /efi) ]] ||
      ESP_MOUNT=/efi
  fi

  [[ -d "$FS_MNT$ESP_MOUNT" ]] ||
    fail "Missing EFI directory $ESP_MOUNT"

  mount -t vfat -o ro,umask=0077 \
    "$ESP" "$FS_MNT$ESP_MOUNT"

  [[ -n $(find "$FS_MNT$ESP_MOUNT/EFI" \
    -type f -iname '*.efi' -print -quit 2>/dev/null || :) ]] ||
    fail 'EFI System Partition contains no recognizable .efi loader.'

  if [[ -d "$FS_MNT$ESP_MOUNT/EFI/Linux" ]]; then
    echo 'NOTE: EFI/Linux may contain UKIs; confirm GRUB boots a separate initramfs.'
  fi
fi

# Inspect GRUB configuration.
CFG=''

for c in \
  "$FS_MNT/boot/grub/grub.cfg" \
  "$FS_MNT/boot/grub2/grub.cfg"; do

  [[ -f $c ]] && CFG=$c && break
done

[[ -n $CFG ]] ||
  fail 'No conventional GRUB configuration found; cannot safely rebuild for unknown bootloader.'

# Identify kernel version.
if [[ -z $KERNEL ]]; then
  shopt -s nullglob
  kernels=("$FS_MNT"/boot/vmlinuz-*)
  shopt -u nullglob

  ((${#kernels[@]} == 1)) ||
    fail "Found ${#kernels[@]} kernels; provide --kernel VERSION explicitly."

  KERNEL=${kernels[0]##*/vmlinuz-}
fi

[[ $KERNEL =~ ^[a-zA-Z0-9._+-]+$ ]] ||
  fail 'Invalid kernel version.'

[[ -f "$FS_MNT/boot/vmlinuz-$KERNEL" ]] ||
  fail 'Kernel file missing.'

[[ -s "$FS_MNT/boot/initrd.img-$KERNEL" ]] ||
  fail 'Conventional initramfs missing; UKI-only boot unsupported.'

[[ -d "$FS_MNT/usr/lib/modules/$KERNEL" ]] ||
  fail 'Kernel modules missing.'

[[ -x "$FS_MNT/usr/bin/dracut" ]] ||
  fail 'Dracut not installed in migrated root.'

[[ -x "$FS_MNT/bin/sh" ||
   -x "$FS_MNT/usr/bin/sh" ]] ||
  fail 'Migrated shell unavailable.'

grep -Fq "$KERNEL" "$CFG" ||
  fail 'GRUB configuration does not reference selected kernel.'

ROOT_UUID=$(blkid -s UUID -o value "$ROOT")
ROOT_PARTUUID=$(blkid -s PARTUUID -o value "$ROOT" || :)

if ! grep -Eq \
  "root=UUID=${ROOT_UUID}([[:space:]\"']|$)|root=PARTUUID=${ROOT_PARTUUID}([[:space:]\"']|$)" \
  "$CFG"; then

  fail 'GRUB does not clearly reference migrated root UUID/PARTUUID. Inspect GRUB before any rebuild.'
fi

log 'Inspection summary'

lsblk -o NAME,SIZE,FSTYPE,UUID,PARTUUID,MOUNTPOINTS "$DISK"

printf 'Firmware: %s\nRoot: %s (%s)\n/boot: %s\nEFI: %s\nKernel: %s\nGRUB: %s\n' \
  "$FW" \
  "$ROOT" \
  "$ROOT_SPEC" \
  "${BOOT:-inside root}" \
  "${ESP:-not used}" \
  "$KERNEL" \
  "${CFG#"$FS_MNT"}"

if (( !APPLY )); then
  log 'PASS: read-only inspection complete; migrated boot files unchanged.'
  echo 'When ready, rerun with --apply and the SAME --disk and --firmware values.'
  exit 0
fi

# Require manual confirmation before modifying the migrated disk.
log 'Destructive-change guard'

echo 'Confirm: SMS and any incremental sync have FINISHED; target ECS is STOPPED;'
echo 'and an AVAILABLE EVS snapshot of this migrated disk has been verified.'
echo 'Only this OFFLINE migrated disk will be modified, never the recovery ECS boot disk.'

printf 'Type exact disk path %s to continue: ' "$DISK"
read -r ANSWER

[[ $ANSWER == "$DISK" ]] ||
  fail 'Confirmation did not match.'

log 'Remounting target root and boot read-write'

umount -R "$FS_MNT"
ROOT_MOUNTED=0

mount_ext4 "$ROOT" "$FS_MNT" rw
ROOT_MOUNTED=1

[[ -z $BOOT ]] ||
  mount_ext4 "$BOOT" "$FS_MNT/boot" rw

[[ $FW != uefi ]] ||
  mount -t vfat -o ro,umask=0077 \
    "$ESP" "$FS_MNT$ESP_MOUNT"

IMG="$FS_MNT/boot/initrd.img-$KERNEL"

TS=$(date -u +%Y%m%dT%H%M%SZ)

BACKUP="$IMG.sms-original.$TS"
CANDIDATE="$IMG.rebuilt.$TS"

cp -a "$IMG" "$BACKUP"

log "Original initramfs preserved: $BACKUP"

# Prepare the migrated OS chroot.
for d in dev proc sys run; do
  [[ -d "$FS_MNT/$d" ]] ||
    fail "Missing /$d in migrated filesystem"
done

mount --rbind /dev "$FS_MNT/dev"
mount --make-rslave "$FS_MNT/dev"

mount -t proc proc "$FS_MNT/proc"

mount --rbind /sys "$FS_MNT/sys"
mount --make-rslave "$FS_MNT/sys"

mount --bind /run "$FS_MNT/run"

# Rebuild the migrated OS boot image.
log 'Building portable Dracut initramfs inside migrated installation'

chroot "$FS_MNT" /usr/bin/dracut \
  --fstab \
  --no-hostonly \
  --no-hostonly-cmdline \
  "/boot/$(basename "$CANDIDATE")" \
  "$KERNEL"

[[ -s $CANDIDATE ]] ||
  fail 'Dracut output is empty or missing.'

file "$CANDIDATE"

MODULES=$(lsinitrd -m "$CANDIDATE")

grep -Eq '^[[:space:]]*rootfs-block[[:space:]]*$' \
  <<< "$MODULES" ||
  fail 'Dracut output missing rootfs-block module. Original remains intact.'

# Check for unexpected embedded root filesystem references.
CMD_ROOTS=$(
  lsinitrd "$CANDIDATE" |
    grep -Eo 'root=(UUID|PARTUUID)=[A-Za-z0-9-]+' || :
)

if [[ -n $CMD_ROOTS ]]; then
  while IFS= read -r value; do
    [[ $value == "root=UUID=$ROOT_UUID" ||
       ( -n $ROOT_PARTUUID &&
         $value == "root=PARTUUID=$ROOT_PARTUUID" ) ]] ||
      fail "Unexpected embedded root reference: $value. Rebuilt image NOT activated."
  done <<< "$CMD_ROOTS"
fi

# Preserve original image and atomically replace the active initramfs.
cp -a "$CANDIDATE" "$IMG.new.$TS"
mv -f "$IMG.new.$TS" "$IMG"

sync

log 'Rebuild installed successfully'

printf 'Backup: %s\nNew image: %s\n' "$BACKUP" "$IMG"

echo 'Cleanup will unmount all temporary recovery mounts.'
echo 'Verify with lsblk BEFORE detaching the disk in Huawei EVS.'
echo 'This does not repair Secure Boot, GRUB/EFI loaders, LUKS, LVM, or UKI-only boot.'
